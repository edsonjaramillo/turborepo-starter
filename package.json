{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "turborepo-starter",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@hookform/resolvers": "^5.2.2",
			"@infisical/cli": "^0.43.84",
			"@tailwindcss/vite": "^4.1.18",
			"@tanstack/devtools-vite": "^0.7.0",
			"@tanstack/react-devtools": "^0.10.5",
			"@tanstack/react-router": "^1.170.10",
			"@tanstack/react-router-devtools": "^1.167.0",
			"@tanstack/react-start": "^1.168.18",
			"@tanstack/router-plugin": "^1.168.11",
			"@tanstack/zod-adapter": "^1.167.0",
			"@types/node": "^25.8.0",
			"@types/react": "^19.2.2",
			"@types/react-dom": "^19.2.2",
			"@vitejs/plugin-react": "^6.0.2",
			"nitro": "^3.0.260603-beta",
			"oxfmt": "^0.50.0",
			"oxlint": "^1.27.0",
			"oxlint-tsgolint": "^0.23.0",
			"react": "^19.2.0",
			"react-dom": "^19.2.0",
			"react-hook-form": "^7.76.0",
			"tailwindcss": "^4.3.0",
			"typescript": "^7.0.1-rc",
			"vite": "^8.0.14",
			"zod": "^4.4.3"
		}
	},
	"scripts": {
		"clean": "turbo run clean",
		"check-types": "turbo run check-types",
		"build": "turbo run build",
		"dev": "turbo run dev",
		"docker:down": "infisical run -- docker compose down",
		"docker:up": "infisical run -- docker compose up -d",
		"format": "turbo run format && oxfmt .oxfmtrc.json bunfig.toml package.json README.md turbo.json",
		"format:check": "turbo run format:check && oxfmt --check .oxfmtrc.json bunfig.toml package.json README.md turbo.json",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix"
	},
	"devDependencies": {
		"@infisical/cli": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"turbo": "^2.9.14",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.3.13",
	"trustedDependencies": [
		"@infisical/cli",
		"argon2",
		"esbuild"
	]
}
