{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@repo/contracts",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./api-contracts": "./src/api-contracts.ts",
		"./auth-contracts": "./src/auth-contracts.ts",
		"./users-contracts": "./src/users-contracts.ts"
	},
	"scripts": {
		"check-types": "tsgo --noEmit",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint --type-aware --type-check src --max-warnings 0",
		"lint:fix": "oxlint --type-aware --type-check src --fix"
	},
	"dependencies": {
		"@repo/http": "workspace:*",
		"@repo/validation": "workspace:*",
		"@ts-rest/core": "^3.53.0-rc.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/config": "workspace:*",
		"@types/node": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:"
	}
}
