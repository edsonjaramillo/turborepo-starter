{
	"$schema": "../../../node_modules/oxlint/configuration_schema.json",
	"extends": ["./library.json"],
	"plugins": [
		"import",
		"jsx-a11y",
		"node",
		"oxc",
		"promise",
		"react",
		"react-perf",
		"typescript",
		"unicorn"
	],
	"categories": {
		"correctness": "error",
		"pedantic": "error",
		"suspicious": "error"
	},
	"rules": {
		"react/react-in-jsx-scope": "off"
	}
}
