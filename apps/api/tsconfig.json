{
	"extends": "@repo/config/typescript/base.json",
	"compilerOptions": {
		"lib": ["ESNext"],
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"exactOptionalPropertyTypes": true,
		"noEmit": true,
		"noUncheckedSideEffectImports": true,
		"types": ["bun"],
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*.ts"]
}
