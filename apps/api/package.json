{
	"$schema": "https://json.schemastore.org/package",
	"name": "api",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"check-types": "tsc --noEmit",
		"clean": "rm -rf dist",
		"db:generate": "infisical run -- drizzle-kit generate",
		"db:migrate": "infisical run -- drizzle-kit migrate",
		"db:push": "infisical run -- drizzle-kit push",
		"db:seed": "infisical run -- bun src/db/scripts/seed.ts",
		"db:studio": "infisical run -- drizzle-kit studio",
		"dev": "infisical run -- tsx watch src/index.ts",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint src drizzle.config.ts --max-warnings 0",
		"lint:fix": "oxlint src vite.config.ts --fix --max-warnings 0"
	},
	"dependencies": {
		"@elysia/cors": "^1.4.2",
		"@elysia/openapi": "^1.4.15",
		"@elysiajs/node": "^1.4.5",
		"@infisical/cli": "^0.43.84",
		"@repo/http": "workspace:*",
		"@repo/validation": "workspace:*",
		"argon2": "^0.44.0",
		"drizzle-orm": "1.0.0-beta.22",
		"drizzle-zod": "^0.8.3",
		"elysia": "^1.4.28",
		"pg": "^8.20.0",
		"uuidv7": "^1.2.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@repo/config": "workspace:*",
		"@types/node": "^25.8.0",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "1.0.0-beta.22",
		"tsx": "^4.22.1",
		"typescript": "^6.0.3"
	}
}
