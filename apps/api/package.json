{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "api",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"clean": "rm -rf dist",
		"build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target bun",
		"check-types": "tsgo --noEmit",
		"dev": "infisical run -- bun --watch src/index.ts",
		"preview": "infisical run -- bun dist/index.js",
		"start": "infisical run -- bun dist/index.js",
		"db:generate": "infisical run -- drizzle-kit generate",
		"db:migrate": "infisical run -- drizzle-kit migrate",
		"db:push": "infisical run -- drizzle-kit push",
		"db:seed": "infisical run -- bun src/db/scripts/seed.ts",
		"db:studio": "infisical run -- drizzle-kit studio",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint src drizzle.config.ts --max-warnings 0",
		"lint:fix": "oxlint src drizzle.config.ts --fix --max-warnings 0"
	},
	"dependencies": {
		"@elysia/cors": "^1.4.2",
		"@elysia/openapi": "^1.4.15",
		"@infisical/cli": "catalog:",
		"@repo/http": "workspace:*",
		"@repo/validation": "workspace:*",
		"argon2": "^0.44.0",
		"drizzle-orm": "1.0.0-beta.22",
		"drizzle-zod": "^0.8.3",
		"elysia": "^1.4.28",
		"pg": "^8.20.0",
		"uuidv7": "^1.2.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/config": "workspace:*",
		"@types/bun": "^1.3.13",
		"@types/node": "catalog:",
		"@types/pg": "^8.20.0",
		"@typescript/native-preview": "catalog:",
		"drizzle-kit": "1.0.0-beta.22",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"tsx": "^4.22.1"
	}
}
