{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "api",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"clean": "rm -rf dist",
		"build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target bun",
		"check-types": "tsgo --noEmit",
		"dev": "infisical run -- bun --watch src/index.ts",
		"preview": "infisical run -- bun dist/index.js",
		"start": "infisical run -- bun dist/index.js",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint src --max-warnings 0",
		"lint:fix": "oxlint src --fix --max-warnings 0"
	},
	"dependencies": {
		"@elysia/cors": "^1.4.2",
		"@elysia/openapi": "^1.4.15",
		"@infisical/cli": "catalog:",
		"@repo/db": "workspace:*",
		"@repo/http": "workspace:*",
		"@repo/security": "workspace:*",
		"@repo/validation": "workspace:*",
		"elysia": "^1.4.28",
		"uuidv7": "^1.2.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/config": "workspace:*",
		"@types/bun": "^1.3.13",
		"@types/node": "catalog:",
		"@typescript/native-preview": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:"
	}
}
