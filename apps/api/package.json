{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "api",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"clean": "rm -rf dist",
		"build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target bun",
		"check-types": "tsgo --noEmit",
		"dev": "infisical run -- bun --watch src/index.ts",
		"preview": "infisical run -- bun dist/index.js",
		"start": "infisical run -- bun dist/index.js",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint src --max-warnings 0",
		"lint:fix": "oxlint src --fix"
	},
	"dependencies": {
		"@fastify/cookie": "^11.0.2",
		"@fastify/cors": "^11.2.0",
		"@infisical/cli": "catalog:",
		"@repo/contracts": "workspace:*",
		"@repo/db": "workspace:*",
		"@repo/http": "workspace:*",
		"@repo/security": "workspace:*",
		"@repo/validation": "workspace:*",
		"@ts-rest/fastify": "^3.52.1",
		"fastify": "^5.8.5",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/config": "workspace:*",
		"@types/node": "catalog:",
		"@typescript/native-preview": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:"
	}
}
